{
  "baseBranchPatterns": [
    "master"
  ],
  "rebaseWhen": "conflicted",
  "semanticCommits": "enabled",
  "labels": [
    "Dependencies"
  ],
  "extends": [
    "config:best-practices"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "enabled": false
    },
    {
      "description": "The multiplatform modules still use com.android.library; a new major needs the migration in desktop/UPSTREAM-MERGES.md first",
      "matchPackageNames": [
        "com.android.tools.build:gradle",
        "com.android.library",
        "com.android.application"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ]
}
